generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PosCommandType {
  UPDATE_PRICE
  UPDATE_PRODUCT_NAME
  UPDATE_STOCK
  APPLY_PROMOTION
  REVERT_PROMOTION
  WRITE_INVOICE
  CREATE_PENDING_STOCK_INTAKE
  CREATE_OR_LINK_SUPPLIER
  DELETE_SUPPLIER
}

enum PosCommandStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                      String   @id @default(uuid())
  name                    String
  email                   String   @unique
  passwordHash            String
  adminSecurityKeyHash    String?
  driverSecurityKeyHash   String?
  cashierSecurityKeyHash  String?
  role                    String   @default("user")
  isActive                Boolean  @default(true)
  emailVerified           Boolean  @default(false)
  failedLoginAttempts     Int      @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  verificationCode        String?
  verificationCodeExpiry  DateTime?
  passwordResetCode       String?
  passwordResetCodeExpiry DateTime?
  cart                    Cart?
  orders                  Order[]
  supportTickets          SupportTicket[]
  permissions             UserPermission[]
  permissionAuditLogsAuthored PermissionAuditLog[] @relation("PermissionAuditActor")
  permissionAuditLogsTargeted PermissionAuditLog[] @relation("PermissionAuditTarget")
  refreshTokens           RefreshToken[]
  securityAuditLogs       SecurityAuditLog[] @relation("SecurityAuditActor")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model SecurityAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  resourceType String  @map("resource_type")
  resourceId  String?  @map("resource_id")
  status      String   @default("SUCCESS")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser User? @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
  @@map("security_audit_logs")
}

model UserPermission {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  permissionKey  String   @map("permission_key")
  allowed        Boolean
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([permissionKey])
  @@map("user_permissions")
}

model PermissionAuditLog {
  id                String   @id @default(uuid())
  actorUserId       String?  @map("actor_user_id")
  targetUserId      String   @map("target_user_id")
  permissionKey     String   @map("permission_key")
  previousValue     Boolean? @map("previous_value")
  newValue          Boolean? @map("new_value")
  reason            String?
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  actorUser  User? @relation("PermissionAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User  @relation("PermissionAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("permission_audit_logs")
}

model Product {
  id                      Int        @id @default(autoincrement())
  branchCode              String     @default("BLANTYRE") @map("branch_code")
  sourceCode              String?
  locationCode            String?    @map("location_code") // POS location code: BT, SH, BAR, ST999, WH, etc.
  name                    String
  price                   Float
  originalPrice           Float?
  discountPrice           Float?
  isOnSale                Boolean    @default(false)
  stock                   Int        @default(0)
  category                String?
  description             String?    @default("")
  barcode                 String?
  expiryDate              DateTime?
  expiryBatchCount        Int        @default(0)
  image                   String?
  isActive                Boolean    @default(true)
  hideFromProductsPage    Boolean    @default(false)
  enabled                 Boolean    @default(true)
  overrideActive          Boolean    @default(false)
  overrideStock           Int?
  lowStockThreshold       Int?       @map("low_stock_threshold")
  overrideReason          String?
  overrideUpdatedAt       DateTime?
  overrideUpdatedBy       String?
  cartItems               CartItem[]
  orderItems              OrderItem[]
  emergencySaleItems      EmergencySaleItem[]
  goodsIntakeItems        GoodsIntakeItem[]
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@unique([branchCode, locationCode, sourceCode])
  @@index([branchCode])
  @@index([enabled])
  @@index([category])
  @@index([name])
}

// Persistent product image mappings keyed by POS ProductCode.
// These survive product row deletion and POS rebuilds.
model ProductImageMapping {
  id                Int      @id @default(autoincrement())
  productCode       String   @unique @map("product_code")
  cloudinaryPublicId String  @map("cloudinary_public_id")
  imageUrl          String   @map("image_url")
  secureUrl         String   @map("secure_url")
  originalFilename  String?  @map("original_filename")
  isPrimary         Boolean  @default(true) @map("is_primary")
  displayOrder      Int      @default(0) @map("display_order")
  altText           String?  @map("alt_text")
  uploadedBy        String?  @map("uploaded_by")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productCode])
  @@map("product_image_mappings")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  subtotalAmount  Float    @default(0) @map("subtotal_amount")
  deliveryFeeAmount Float  @default(0) @map("delivery_fee_amount")
  finalTotalAmount Float   @default(0) @map("final_total_amount")
  total           Float
  vatEnabled      Boolean  @default(true) @map("vat_enabled")
  vatRatePercent  Float    @default(16.5) @map("vat_rate_percent")
  vatAmount       Float    @default(0) @map("vat_amount")
  status          String   @default("PENDING")
  deliveryAddress String
  houseNumber     String
  phone           String?
  district        String?
  area            String?
  latitude        Float?
  longitude       Float?
  paymentStatus   String   @default("PENDING")
  paymentReference String?
  notes           String?
  driverId        String?
  driver          Driver?  @relation("DriverOrders", fields: [driverId], references: [id])
  salesDayId      Int?
  salesDay        SalesDay? @relation(fields: [salesDayId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DeliveryZone {
  id          Int      @id @default(autoincrement())
  district    String
  area        String
  isActive    Boolean  @default(true)
  latitude    Float?
  longitude   Float?
  radiusKm    Float?
  deliveryFee Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([district, area])
  @@index([district, isActive])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id             String   @id @default(uuid())
  name           String
  phone          String?  @unique
  email          String?  @unique
  assignedOrders Order[]  @relation("DriverOrders")
  createdAt      DateTime @default(now())
}

model SalesDay {
  id          Int      @id @default(autoincrement())
  date        DateTime
  status      String   @default("OPEN")
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  totalSales  Float    @default(0)
  totalOrders Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id        Int       @id @default(autoincrement())
  subject   String
  message   String
  status    String    @default("OPEN")
  priority  String    @default("MEDIUM")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  replies   TicketReply[]
}

model TicketReply {
  id          Int      @id @default(autoincrement())
  message     String
  createdAt   DateTime @default(now())

  ticketId    Int
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId    String
  attachments TicketAttachment[]
}

model TicketAttachment {
  id        Int      @id @default(autoincrement())
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  replyId   Int
  reply     TicketReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
}

model TicketReadStatus {
  id        Int     @id @default(autoincrement())
  ticketId  Int
  userId    String
  lastRead  DateTime @default(now()) @updatedAt

  @@unique([ticketId, userId])
}

model Promotion {
  id           Int      @id @default(autoincrement())
  branchCode   String   @default("BLANTYRE") @map("branch_code")
  type         String   // 'global', 'category', or 'selective'
  enabled      Boolean  @default(false)
  percentage   Int      @default(10) // Discount percentage
  categoryId   String?  // For category promotions
  selectedProductIds Int[]  @default([]) // For selective promotions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([branchCode, type])
}

model AdminMessage {
  id              Int      @id @default(autoincrement())
  type            String   // new_user, payment_success, order_placed, order_completed, payment_failed, driver_assigned, system
  title           String
  message         String
  read            Boolean  @default(false)
  dedupeKey       String?
  sourceModule    String?  @map("source_module")
  branchCode      String?  @map("branch_code")
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  errorCode       String?  @map("error_code")
  lifecycleState  String   @default("active") @map("lifecycle_state")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  acknowledgedAt  DateTime? @map("acknowledged_at")
  resolvedAt      DateTime? @map("resolved_at")
  occurrenceCount Int      @default(1) @map("occurrence_count")
  statusMetadata  Json?    @map("status_metadata")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type, createdAt])
  @@index([dedupeKey, lifecycleState, lastSeenAt])
  @@index([branchCode, type, lastSeenAt])
}

model PendingUser {
  id                      String   @id @default(uuid())
  name                    String
  email                   String   @unique
  passwordHash            String
  verificationCode        String
  verificationCodeExpiry  DateTime
  createdAt               DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String   @unique
  resetCode String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PosWriteCommand {
  id                String           @id @default(cuid())
  commandType       PosCommandType
  status            PosCommandStatus @default(PENDING)
  payload           Json
  source            String
  relatedEntityType String?
  relatedEntityId   String?
  createdBy         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  pickedAt          DateTime?
  processedAt       DateTime?
  retryCount        Int              @default(0)
  maxRetries        Int              @default(5)
  nextRetryAt       DateTime?
  errorMessage      String?
  resultSummary     Json?
  agentId           String?
  lockToken         String?

  @@index([status, createdAt])
  @@index([agentId, status])
  @@index([status, nextRetryAt])
}

model SiteSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PosSyncEvent {
  id         String   @id @default(cuid())
  eventType  String
  source     String
  status     String
  level      String
  title      String
  message    String
  reason     String?
  suggestion String?
  entityType String?
  entityId   String?
  agentId    String?
  durationMs Int?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([eventType, createdAt])
}

model ProductExpiryBatch {
  id                      Int       @id @default(autoincrement())
  productCode             String
  expiryDate              DateTime
  remainingQty            Float
  locationCode            String?
  batchNo                 String?
  lastSyncedAt            DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([productCode])
  @@index([expiryDate])
  @@unique([productCode, expiryDate, locationCode, batchNo])
}

model EmergencySale {
  id                Int                 @id @default(autoincrement())
  saleRef           String              @unique @map("sale_ref")
  cashierId         String?             @map("cashier_id")
  cashierName       String              @map("cashier_name")
  subtotal          Float
  discount          Float               @default(0)
  total             Float
  tenderedAmount    Float               @map("tendered_amount")
  changeAmount      Float               @map("change_amount")
  paymentMethod     String              @default("CASH") @map("payment_method")
  syncStatus        String              @default("pending_pos_sync") @map("sync_status")
  posInvoiceNo      String?             @map("pos_invoice_no")
  syncedAt          DateTime?           @map("synced_at")
  lastSyncAttemptAt DateTime?           @map("last_sync_attempt_at")
  retryCount        Int                 @default(0) @map("retry_count")
  syncError         String?             @map("sync_error")
  cartSnapshot      Json?               @map("cart_snapshot")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  items             EmergencySaleItem[]

  @@index([syncStatus, createdAt])
  @@index([retryCount, syncStatus])
  @@map("emergency_sales")
}

model EmergencySaleItem {
  id              Int           @id @default(autoincrement())
  emergencySaleId Int           @map("emergency_sale_id")
  emergencySale   EmergencySale @relation(fields: [emergencySaleId], references: [id], onDelete: Cascade)
  productId       Int?          @map("product_id")
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCode     String        @map("product_code")
  barcode         String?
  productName     String        @map("product_name")
  unitPrice       Float         @map("unit_price")
  qty             Int
  lineTotal       Float         @map("line_total")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([emergencySaleId])
  @@index([productId])
  @@map("emergency_sale_items")
}

model Quotation {
  id            Int             @id @default(autoincrement())
  quotationRef  String          @unique @map("quotation_ref")
  branchCode    String          @default("BLANTYRE") @map("branch_code")
  locationCode  String          @default("BT") @map("location_code")
  clientName    String          @map("client_name")
  clientEmail   String?         @map("client_email")
  clientPhone   String?         @map("client_phone")
  clientAddress String?         @map("client_address")
  notes         String?
  subtotal      Float
  discount      Float           @default(0)
  total         Float
  validUntil    DateTime?       @map("valid_until")
  createdBy     String?         @map("created_by")
  items         QuotationItem[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([clientName])
  @@index([createdAt])
  @@index([branchCode, locationCode, createdAt])
  @@map("quotations")
}

model QuotationItem {
  id            Int        @id @default(autoincrement())
  quotationId   Int        @map("quotation_id")
  quotation     Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     Int?       @map("product_id")
  productName   String     @map("product_name")
  description   String?
  qty           Int
  unitPrice     Float      @map("unit_price")
  lineTotal     Float      @map("line_total")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([quotationId])
  @@map("quotation_items")
}

model SalesSyncSource {
  id            Int           @id @default(autoincrement())
  branchCode    String        @map("branch_code")
  branchName    String        @map("branch_name")
  locationId    Int?          @map("location_id")
  syncSourceCode String       @unique @map("sync_source_code")
  lastSeenAt    DateTime      @default(now()) @map("last_seen_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  invoices      SalesInvoice[]
  latestProductCosts PosLatestProductCost[]
  posStockIntakes PosStockIntake[]

  @@map("sales_sync_sources")
}

model PosLatestProductCost {
  id                 Int             @id @default(autoincrement())
  syncSourceId       Int             @map("sync_source_id")
  syncSource         SalesSyncSource @relation(fields: [syncSourceId], references: [id], onDelete: Cascade)
  branchCode         String          @map("branch_code")
  branchName         String          @map("branch_name")
  locationId         Int?            @map("location_id")
  locationCode       String?         @map("location_code")
  syncSourceCode     String          @map("sync_source_code")
  productCode        String          @map("product_code")
  productName        String?         @map("product_name")
  latestUnitCost     Float?          @map("latest_unit_cost")
  latestGrnNo        String?         @map("latest_grn_no")
  latestGrnReference String?         @map("latest_grn_reference")
  latestGrnDate      DateTime?       @map("latest_grn_date")
  stockDetailId      String?         @map("stock_detail_id")
  sourceUpdatedAt    DateTime?       @map("source_updated_at")
  sourceSyncedAt     DateTime?       @map("source_synced_at")
  firstReceivedAt    DateTime        @default(now()) @map("first_received_at")
  lastReceivedAt     DateTime        @default(now()) @map("last_received_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@unique([syncSourceCode, productCode])
  @@index([syncSourceCode])
  @@index([productCode])
  @@index([branchCode, productCode])
  @@index([locationCode, productCode])
  @@map("pos_latest_product_costs")
}

model SalesInvoice {
  id                  BigInt             @id @default(autoincrement())
  syncSourceId        Int                @map("sync_source_id")
  syncSource          SalesSyncSource    @relation(fields: [syncSourceId], references: [id], onDelete: Restrict)
  branchCode          String             @map("branch_code")
  branchName          String             @map("branch_name")
  locationId          Int?               @map("location_id")
  syncSourceCode      String             @map("sync_source_code")
  sourceInvoiceNo     Int                @map("source_invoice_no")
  sourceInvoiceSerialNo Int?             @map("source_invoice_serial_no")
  sourceCashSaleNo    Int?               @map("source_cash_sale_no")
  refNo               String?            @map("ref_no")
  invoiceDate         DateTime?          @map("invoice_date")
  invoiceTime         DateTime?          @map("invoice_time")
  customerCode        String?            @map("customer_code")
  customerDetails     String?            @map("customer_details")
  locationCode        String?            @map("location_code")
  grossSale           Float              @default(0) @map("gross_sale")
  vatAmount           Float              @default(0) @map("vat_amount")
  discount            Float              @default(0)
  netSale             Float              @default(0) @map("net_sale")
  invoiceType         String?            @map("invoice_type")
  tillId              Int?               @map("till_id")
  payMethod1          String?            @map("pay_method_1")
  tenderAmount1       Float?             @map("tender_amount_1")
  chqNo1              String?            @map("chq_no_1")
  payMethod2          String?            @map("pay_method_2")
  tenderAmount2       Float?             @map("tender_amount_2")
  chqNo2              String?            @map("chq_no_2")
  userName            String?            @map("user_name")
  priceTypeCode       String?            @map("price_type_code")
  repCode             String?            @map("rep_code")
  uploadStatus        Int?               @map("upload_status")
  levyAmount          Float?             @map("levy_amount")
  reserved            Int?
  discountAmount      Float?             @map("discount_amount")
  fiscalReceiptNo     String?            @map("fiscal_receipt_no")
  bankCode            String?            @map("bank_code")
  bankName            String?            @map("bank_name")
  bankCardHolder      String?            @map("bank_card_holder")
  bankCardNo          String?            @map("bank_card_no")
  bankCardExpiry      String?            @map("bank_card_expiry")
  quoteNo             String?            @map("quote_no")
  sourceSyncedAt      DateTime?          @map("source_synced_at")
  firstReceivedAt     DateTime           @default(now()) @map("first_received_at")
  lastReceivedAt      DateTime           @default(now()) @map("last_received_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  items               SalesInvoiceItem[]

  @@unique([syncSourceCode, sourceInvoiceNo, locationCode])
  @@index([syncSourceCode])
  @@index([sourceInvoiceNo])
  @@index([invoiceDate])
  @@index([userName])
  @@index([locationCode])
  @@index([branchCode])
  @@index([branchCode, invoiceDate])
  @@index([syncSourceCode, invoiceDate])
  @@index([payMethod1])
  @@index([payMethod2])
  @@index([invoiceType])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id                BigInt       @id @default(autoincrement())
  salesInvoiceId    BigInt       @map("sales_invoice_id")
  salesInvoice      SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  syncSourceCode    String       @map("sync_source_code")
  sourceInvDetailId Int          @map("source_inv_detail_id")
  sourceInvoiceCode Int?         @map("source_invoice_code")
  productCode       String?      @map("product_code")
  productName       String?      @map("product_name")
  qty               Float        @default(0)
  priceTypeCode     String?      @map("price_type_code")
  unitPrice         Float?       @map("unit_price")
  bulkPrice         Float?       @map("bulk_price")
  discount          Float?
  amount            Float?
  startSerialNo     String?      @map("start_serial_no")
  endSerialNo       String?      @map("end_serial_no")
  taxRate           Float?       @map("tax_rate")
  taxAmount         Float?       @map("tax_amount")
  fPrice            Float?       @map("f_price")
  uploadStatus      Int?         @map("upload_status")
  locationCode      String?      @map("location_code")
  levyRate          Float?       @map("levy_rate")
  levyAmount        Float?       @map("levy_amount")
  printed           Int?
  subQty            Float?       @map("sub_qty")
  discountAmount    Float?       @map("discount_amount")
  costPrice         Float?       @map("cost_price")
  grnDate           DateTime?    @map("grn_date")
  firstReceivedAt   DateTime     @default(now()) @map("first_received_at")
  lastReceivedAt    DateTime     @default(now()) @map("last_received_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

