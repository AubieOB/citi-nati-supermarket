generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PosCommandType {
  UPDATE_PRICE
  UPDATE_STOCK
  APPLY_PROMOTION
  REVERT_PROMOTION
  WRITE_INVOICE
}

enum PosCommandStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                      String   @id @default(uuid())
  name                    String
  email                   String   @unique
  passwordHash            String
  adminSecurityKeyHash    String?
  driverSecurityKeyHash   String?
  cashierSecurityKeyHash  String?
  role                    String   @default("user")
  isActive                Boolean  @default(true)
  emailVerified           Boolean  @default(false)
  verificationCode        String?
  verificationCodeExpiry  DateTime?
  passwordResetCode       String?
  passwordResetCodeExpiry DateTime?
  cart                    Cart?
  orders                  Order[]
  supportTickets          SupportTicket[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Product {
  id                      Int        @id @default(autoincrement())
  sourceCode              String?    @unique
  name                    String
  price                   Float
  originalPrice           Float?
  discountPrice           Float?
  isOnSale                Boolean    @default(false)
  stock                   Int        @default(0)
  category                String?
  description             String?    @default("")
  barcode                 String?
  expiryDate              DateTime?
  expiryBatchCount        Int        @default(0)
  image                   String?
  isActive                Boolean    @default(true)
  hideFromProductsPage    Boolean    @default(false)
  enabled                 Boolean    @default(true)
  overrideActive          Boolean    @default(false)
  overrideStock           Int?
  lowStockThreshold       Int?       @map("low_stock_threshold")
  overrideReason          String?
  overrideUpdatedAt       DateTime?
  overrideUpdatedBy       String?
  cartItems               CartItem[]
  orderItems              OrderItem[]
  emergencySaleItems      EmergencySaleItem[]
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@index([enabled])
  @@index([category])
  @@index([name])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  total           Float
  status          String   @default("PENDING")
  deliveryAddress String
  houseNumber     String
  phone           String?
  latitude        Float?
  longitude       Float?
  paymentStatus   String   @default("PENDING")
  paymentReference String?
  notes           String?
  driverId        String?
  driver          Driver?  @relation("DriverOrders", fields: [driverId], references: [id])
  salesDayId      Int?
  salesDay        SalesDay? @relation(fields: [salesDayId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id             String   @id @default(uuid())
  name           String
  phone          String?  @unique
  email          String?  @unique
  assignedOrders Order[]  @relation("DriverOrders")
  createdAt      DateTime @default(now())
}

model SalesDay {
  id          Int      @id @default(autoincrement())
  date        DateTime
  status      String   @default("OPEN")
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  totalSales  Float    @default(0)
  totalOrders Int      @default(0)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SupportTicket {
  id        Int       @id @default(autoincrement())
  subject   String
  message   String
  status    String    @default("OPEN")
  priority  String    @default("MEDIUM")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  replies   TicketReply[]
}

model TicketReply {
  id          Int      @id @default(autoincrement())
  message     String
  createdAt   DateTime @default(now())

  ticketId    Int
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId    String
  attachments TicketAttachment[]
}

model TicketAttachment {
  id        Int      @id @default(autoincrement())
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  replyId   Int
  reply     TicketReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
}

model TicketReadStatus {
  id        Int     @id @default(autoincrement())
  ticketId  Int
  userId    String
  lastRead  DateTime @default(now()) @updatedAt

  @@unique([ticketId, userId])
}

model Promotion {
  id           Int      @id @default(autoincrement())
  type         String   @unique // 'global', 'category', or 'selective'
  enabled      Boolean  @default(false)
  percentage   Int      @default(10) // Discount percentage
  categoryId   String?  // For category promotions
  selectedProductIds Int[]  @default([]) // For selective promotions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminMessage {
  id        Int      @id @default(autoincrement())
  type      String   // new_user, payment_success, order_placed, order_completed, payment_failed, driver_assigned, system
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PendingUser {
  id                      String   @id @default(uuid())
  name                    String
  email                   String   @unique
  passwordHash            String
  verificationCode        String
  verificationCodeExpiry  DateTime
  createdAt               DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String   @unique
  resetCode String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PosWriteCommand {
  id                String           @id @default(cuid())
  commandType       PosCommandType
  status            PosCommandStatus @default(PENDING)
  payload           Json
  source            String
  relatedEntityType String?
  relatedEntityId   String?
  createdBy         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  pickedAt          DateTime?
  processedAt       DateTime?
  retryCount        Int              @default(0)
  maxRetries        Int              @default(5)
  nextRetryAt       DateTime?
  errorMessage      String?
  resultSummary     Json?
  agentId           String?
  lockToken         String?

  @@index([status, createdAt])
  @@index([agentId, status])
  @@index([status, nextRetryAt])
}

model SiteSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductExpiryBatch {
  id                      Int       @id @default(autoincrement())
  productCode             String
  expiryDate              DateTime
  remainingQty            Float
  locationCode            String?
  batchNo                 String?
  lastSyncedAt            DateTime  @default(now())
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([productCode])
  @@index([expiryDate])
  @@unique([productCode, expiryDate, locationCode, batchNo])
}

model EmergencySale {
  id                Int                 @id @default(autoincrement())
  saleRef           String              @unique @map("sale_ref")
  cashierId         String?             @map("cashier_id")
  cashierName       String              @map("cashier_name")
  subtotal          Float
  discount          Float               @default(0)
  total             Float
  tenderedAmount    Float               @map("tendered_amount")
  changeAmount      Float               @map("change_amount")
  paymentMethod     String              @default("CASH") @map("payment_method")
  syncStatus        String              @default("pending_pos_sync") @map("sync_status")
  posInvoiceNo      String?             @map("pos_invoice_no")
  syncedAt          DateTime?           @map("synced_at")
  lastSyncAttemptAt DateTime?           @map("last_sync_attempt_at")
  retryCount        Int                 @default(0) @map("retry_count")
  syncError         String?             @map("sync_error")
  cartSnapshot      Json?               @map("cart_snapshot")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  items             EmergencySaleItem[]

  @@index([syncStatus, createdAt])
  @@index([retryCount, syncStatus])
  @@map("emergency_sales")
}

model EmergencySaleItem {
  id              Int           @id @default(autoincrement())
  emergencySaleId Int           @map("emergency_sale_id")
  emergencySale   EmergencySale @relation(fields: [emergencySaleId], references: [id], onDelete: Cascade)
  productId       Int?          @map("product_id")
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productCode     String        @map("product_code")
  barcode         String?
  productName     String        @map("product_name")
  unitPrice       Float         @map("unit_price")
  qty             Int
  lineTotal       Float         @map("line_total")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([emergencySaleId])
  @@index([productId])
  @@map("emergency_sale_items")
}