{
  "name": "citi-nati-admin-desktop",
  "version": "1.0.0",
  "description": "Citi-Nati Supermarket Admin Desktop Application",
  "main": "src/main.js",
  "homepage": "./",
  "author": "Citi-Nati Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron . --development",
    "start": "electron .",
    "build": "electron-builder",
    "prebuild:win": "cd ../../citi-nati-frontend && npm run build:electron",
    "prepare:packaging": "node ./scripts/sync-packaging-assets.js",
    "build:win": "npm run prepare:packaging && node ./scripts/prepare-icons.js && electron-builder --win nsis",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "electron-store": "^8.1.0"
  },
    "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-notarize": "^1.2.2"
  },
  "build": {
    "appId": "com.citi-nati.admin",
    "productName": "Citi-Nati Admin",
    "directories": {
      "buildResources": "public",
      "output": "dist-electron"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "citi-nati-frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Citi-Nati Admin Setup.${ext}",
      "icon": "public/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
