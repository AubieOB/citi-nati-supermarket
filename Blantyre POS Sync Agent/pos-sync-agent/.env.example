# ============================================================================
# POS SYNC AGENT - MULTI BRANCH CONFIGURATION
# ============================================================================

# ---------------------------------------------------------------------------
# BRANCH IDENTITY (required)
# ---------------------------------------------------------------------------
BRANCH_CODE=BLANTYRE
BRANCH_NAME=Blantyre
LOCATION_ID=1
SYNC_SOURCE_CODE=BLANTYRE_POS_01
SYNC_LOG_PREFIX=[BLANTYRE SYNC]

# ---------------------------------------------------------------------------
# BACKEND CONNECTIVITY (required for reporting sync and queue polling)
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:5000
# Legacy fallback (optional): BACKEND_BASE_URL / LIVE_SERVER_URL
BACKEND_API_TOKEN=replace-with-backend-pos-token

# ---------------------------------------------------------------------------
# AGENT SECURITY (required)
# ---------------------------------------------------------------------------
# Used for inbound requests to this agent (x-pos-secret header)
POS_SECRET=replace-with-agent-secret

# ---------------------------------------------------------------------------
# POS SQL SERVER CONNECTION (required)
# ---------------------------------------------------------------------------
POS_DB_SERVER=localhost
POS_DB_NAME=POS
POS_DB_USER=pos_sync_writer
POS_DB_PASSWORD=ChooseAVeryStrongPasswordHere!123
POS_LOCATION_CODE=SH

# ---------------------------------------------------------------------------
# POLLING / SERVER
# ---------------------------------------------------------------------------
PORT=3001
POLLING_INTERVAL_MS=60000
POLL_INTERVAL_MS=60000
COMMAND_POLL_INTERVAL_MS=5000
EMERGENCY_SALES_POLL_INTERVAL_MS=7000
COMMAND_POLL_TIMEOUT_MS=15000
POS_AGENT_ID=shop-main-agent

# ---------------------------------------------------------------------------
# STARTUP / DEPLOYMENT CONTROLS
# ---------------------------------------------------------------------------
AGENT_NAME=blantyre-pos-sync-agent
AGENT_ENV=development
INSTANCE_LOCK_PORT=13001
BACKEND_CONNECTION_TEST_ENABLED=true
BACKEND_CONNECTION_TIMEOUT_MS=5000
BACKEND_HEALTHCHECK_PATH=/api/health

# ---------------------------------------------------------------------------
# REPORTING SYNC (optional)
# ---------------------------------------------------------------------------
REPORTING_BACKEND_ENDPOINT=/api/pos-sync/reporting/invoices
REPORTING_LATEST_COST_ENDPOINT=/api/pos-sync/reporting/latest-product-costs
REPORTING_BATCH_SIZE=100
REPORTING_POLLING_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# FEATURE FLAGS
# ---------------------------------------------------------------------------
ENABLE_REPORTING_SYNC=true
ENABLE_ONLINE_ORDER_WRITEBACK=true
ENABLE_STOCK_WRITEBACK=true
ENABLE_PROMOTION_SYNC=true
ENABLE_PRICE_SYNC=true
ENABLE_MANUAL_STOCK_SYNC=true
ENABLE_INVOICE_WRITEBACK=true

# Optional debug-only direct writeback endpoint
ENABLE_DIRECT_POS_WRITEBACK_DEBUG=false

# ---------------------------------------------------------------------------
# LEGACY COMPATIBILITY (optional, deprecated aliases)
# ---------------------------------------------------------------------------
# BACKEND_BASE_URL=...
# LIVE_SERVER_URL=...
# DB_SERVER=...
# DB_NAME=...
# DB_DATABASE=...
# DB_USER=...
# DB_PASSWORD=...
