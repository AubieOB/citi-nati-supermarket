# Copy to .env.local, ignored by Git. Do not reuse live website, provider or merchant credentials.
# This is a separate operator-only test store, not a replacement live customer checkout.
CITI_ERP_TEST_ENABLED=false
CITI_ERP_TEST_TENANT_CONFIRMED=
ERP_TEST_BASE_URL=https://YOUR-APPROVED-TEST-ERP
ERP_TEST_CREDENTIAL=
ERP_TEST_SIGNING_SECRET=
ERP_TEST_OPERATOR=tester
ERP_TEST_OPERATOR_PASSWORD=
CITI_ERP_TEST_PORT=5081
# Set to the exact HTTPS test subdomain only when serving behind its own authenticated VPS virtual host.
CITI_ERP_TEST_ORIGIN=
# HTTP loopback ERP transport is allowed only with NODE_ENV=test, for the isolated local harness.
NODE_ENV=test
