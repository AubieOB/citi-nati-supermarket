# SQL Server Configuration
DB_SERVER=localhost
DB_DATABASE=POS
DB_USER=sa
DB_PASSWORD=YourPasswordHere

# Server Configuration
PORT=3001

# POS Location Code (for filtering stock by location)
# This ensures only stock from your actual selling location is synced
# Default: 'SH' (change if your location code is different)
POS_LOCATION_CODE=SH

# API Security
POS_SECRET=your-secret-key-here-change-in-production
