/**
 * Environment Variables Template for Electron Apps
 * 
 * Each desktop app folder should have a .env file with these variables.
 * Copy to: desktop-apps/{admin,cashier,driver}/.env
 */

# API Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_WEB_URL=http://localhost:3000

# App Configuration
REACT_APP_APP_NAME=Citi-Nati Admin|Cashier|Driver
REACT_APP_APP_VERSION=1.0.0

# Development
REACT_APP_DEBUG=false

# Production API (update before building)
# REACT_APP_API_URL=https://api.citi-nati.com
# REACT_APP_WEB_URL=https://citi-nati.com
