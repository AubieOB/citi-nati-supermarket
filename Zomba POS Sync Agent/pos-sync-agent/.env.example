# ============================================================================
# POS SYNC AGENT - MULTI BRANCH CONFIGURATION
# ============================================================================

# ---------------------------------------------------------------------------
# BRANCH IDENTITY (required)
# ---------------------------------------------------------------------------
BRANCH_CODE=ZOMBA
BRANCH_NAME=Zomba
LOCATION_ID=2
SYNC_SOURCE_CODE=ZOMBA_POS_01
SYNC_LOG_PREFIX=[ZOMBA SYNC]

# ---------------------------------------------------------------------------
# BACKEND CONNECTIVITY (required for reporting sync and queue polling)
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:5000
# Legacy fallback (optional): BACKEND_BASE_URL / LIVE_SERVER_URL
BACKEND_API_TOKEN=replace-with-backend-pos-token

# ---------------------------------------------------------------------------
# AGENT SECURITY (required)
# ---------------------------------------------------------------------------
# Used for inbound requests to this agent (x-pos-secret header)
POS_SECRET=replace-with-agent-secret

# ---------------------------------------------------------------------------
# POS SQL SERVER CONNECTION (required)
# ---------------------------------------------------------------------------
POS_DB_SERVER=localhost
POS_DB_NAME=POS
POS_DB_USER=pos_sync_writer
POS_DB_PASSWORD=ChooseAVeryStrongPasswordHere!123
POS_LOCATION_CODE=SH
# Operational locations to sync for multi-location branches (comma-separated).
# Defaults to SH,BAR,ST999 for ZOMBA. Not required for single-location branches.
POS_OPERATIONAL_LOCATION_CODES=SH,BAR,ST999

# ---------------------------------------------------------------------------
# POLLING / SERVER
# ---------------------------------------------------------------------------
PORT=3001
POLLING_INTERVAL_MS=60000
POLL_INTERVAL_MS=60000
COMMAND_POLL_INTERVAL_MS=5000
EMERGENCY_SALES_POLL_INTERVAL_MS=7000
COMMAND_POLL_TIMEOUT_MS=15000
POS_AGENT_ID=shop-main-agent

# ---------------------------------------------------------------------------
# STARTUP / DEPLOYMENT CONTROLS
# ---------------------------------------------------------------------------
AGENT_NAME=zomba-pos-sync-agent
AGENT_ENV=development
INSTANCE_LOCK_PORT=13001
BACKEND_CONNECTION_TEST_ENABLED=true
BACKEND_CONNECTION_TIMEOUT_MS=5000
BACKEND_HEALTHCHECK_PATH=/api/health

# ---------------------------------------------------------------------------
# REPORTING SYNC (optional)
# ---------------------------------------------------------------------------
REPORTING_BACKEND_ENDPOINT=/api/pos-sync/reporting/invoices
REPORTING_LATEST_COST_ENDPOINT=/api/pos-sync/reporting/latest-product-costs
REPORTING_BATCH_SIZE=100
REPORTING_POLLING_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# FEATURE FLAGS
# ---------------------------------------------------------------------------
ENABLE_REPORTING_SYNC=true
ENABLE_ONLINE_ORDER_WRITEBACK=true
ENABLE_STOCK_WRITEBACK=true
ENABLE_PROMOTION_SYNC=true
ENABLE_PRICE_SYNC=true
ENABLE_MANUAL_STOCK_SYNC=true
ENABLE_INVOICE_WRITEBACK=true

# Optional debug-only direct writeback endpoint
ENABLE_DIRECT_POS_WRITEBACK_DEBUG=false

# ---------------------------------------------------------------------------
# STOCK SYNCHRONIZATION & RESOLUTION (Zomba-specific tuning)
# ---------------------------------------------------------------------------
# Delta sync: Track product changes and only sync modified products
ENABLE_DELTA_PRODUCT_SYNC=true
# How often to force a full product sync even when delta sync is enabled (cycles)
DELTA_FULL_SYNC_EVERY_CYCLES=40
# Persist delta sync state across agent restarts (file-based)
PERSIST_DELTA_SYNC_STATE=true
# Directory where delta sync state files are stored
DELTA_STATE_DIR=./.sync-state

# Stock source staleness thresholds
DAILY_STOCK_MAX_STALENESS_DAYS=1
PRODUCT_ACTIVITY_FRESHNESS_WINDOW_MINUTES=5
PRODUCT_ACTIVITY_FALLBACK_MAX_ABS_STOCK=2000
EXPIRY_BATCH_CACHE_TTL_MS=300000

# Supplier sync interval (5 minutes default)
SUPPLIER_SYNC_INTERVAL_MS=300000

# Debug logging: Set to true to see detailed stock resolution, delta sync, and source tracing
DEBUG_STOCK_RESOLUTION=false

# ---------------------------------------------------------------------------
# LIVE_SERVER_URL=...
# DB_SERVER=...
# DB_NAME=...
# DB_DATABASE=...
# DB_USER=...
# DB_PASSWORD=...

# ---------------------------------------------------------------------------
# SAMPLE DEPLOYMENT: BLANTYRE (FULL FEATURE)
# ---------------------------------------------------------------------------
# BRANCH_CODE=BLANTYRE
# BRANCH_NAME=Blantyre
# LOCATION_ID=1
# SYNC_SOURCE_CODE=BLANTYRE_POS_01
# ENABLE_REPORTING_SYNC=true
# ENABLE_ONLINE_ORDER_WRITEBACK=true
# ENABLE_STOCK_WRITEBACK=true
# ENABLE_PROMOTION_SYNC=true
# ENABLE_PRICE_SYNC=true
# ENABLE_MANUAL_STOCK_SYNC=true
# ENABLE_INVOICE_WRITEBACK=true

# ---------------------------------------------------------------------------
# SAMPLE DEPLOYMENT: ZOMBA (REPORTING ONLY)
# ---------------------------------------------------------------------------
# BRANCH_CODE=ZOMBA
# BRANCH_NAME=Zomba
# LOCATION_ID=2
# SYNC_SOURCE_CODE=ZOMBA_POS_01
# ENABLE_REPORTING_SYNC=true
# ENABLE_ONLINE_ORDER_WRITEBACK=false
# ENABLE_STOCK_WRITEBACK=false
# ENABLE_PROMOTION_SYNC=false
# ENABLE_PRICE_SYNC=false
# ENABLE_MANUAL_STOCK_SYNC=false
# ENABLE_INVOICE_WRITEBACK=false
